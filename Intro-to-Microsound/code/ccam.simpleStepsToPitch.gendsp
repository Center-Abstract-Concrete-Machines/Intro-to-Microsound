                    "code": "note = 0; \r\n\r\nindex = in1;\r\n\r\n\r\nif(index == 0){\r\nnote = 0;\r\n}\r\n\r\nif (index == 1){\r\nnote = 2;\r\n}\r\nelse if(index == 2){\r\nnote = third + 3;\r\n}\r\nelse if(index == 3){\r\nnote = 5;\r\n}\r\nelse if(index == 4){\r\nnote = 7;\r\n}\r\nelse if(index == 5){\r\nnote = 8 + sixth;\r\n}\r\n\r\n\r\nelse if(in1 == 5){\r\nnote = 8 + sixth;\r\n}\r\n\r\nelse if(in1 == 6){\r\nnote = 10 + seventh;\r\n}\r\n\r\nout1 = note + midiOffset; ",
